MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/phonevault
# Needed to add/edit/delete phones and view orders (sent as the x-admin-key header)
ADMIN_API_KEY=change-me-to-a-long-random-string
# Leave MONGODB_URI unset to run on the built-in demo store: the sample catalogue and orders live in memory
# and reset when the server restarts. Check which store is active at /api/health.
